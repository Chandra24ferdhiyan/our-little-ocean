# ====================================================================
# CANDUT & REPA — OUR LITTLE OCEAN
# Environment Variables Example
# ====================================================================

# Supabase Public Keys (Required for connecting to your Supabase project)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key

# Service Role Key (Keep secret on server only; never expose to client!)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Application Settings
NEXT_PUBLIC_APP_NAME="Candut & Repa — Our Little Ocean"
NEXT_PUBLIC_APP_URL=http://localhost:3000
